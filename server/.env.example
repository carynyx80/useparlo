# ---------------------------------------------------------------------------
# Parlo server. Everything is optional except PORT (defaults to 8080).
# Never commit real private keys. Use Railway variables for secrets.
# ---------------------------------------------------------------------------

# HTTP
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info                 # trace|debug|info|warn|error
# Extra exact CORS origins, comma separated. Built in: https://useparlo.xyz, https://www.useparlo.xyz,
# https://*.vercel.app, http(s)://localhost:*, 127.0.0.1:*
CORS_EXTRA_ORIGINS=

# Chain
CHAIN_ID=56                    # 56 = BSC mainnet, 97 = BSC testnet
RPC_URL=                       # default: https://bsc-dataseed.bnbchain.org (56) / bsc-testnet-dataseed (97)
EPOCH_LENGTH=300               # must match the oracle/pool constructor arg (seconds)

# Indexer
INDEX_INTERVAL_SEC=60          # one scoring round per minute (matches 1-minute ring buffer)
SIMULATE=                      # 1 = use only the deterministic simulator (demo mode)
SIM_BACKFILL=                  # 1 = fill empty history with 7 days of simulated data on boot (demo only)
DATA_DIR=                      # e.g. /data on a Railway volume; persists scores.json snapshots
SNAPSHOT_INTERVAL_SEC=300
REDDIT_USER_AGENT=parlo-indexer/1.0
REDDIT_CLIENT_ID=              # optional Reddit "script/app-only" OAuth; strongly recommended on cloud hosts
REDDIT_CLIENT_SECRET=          #   (Reddit often 403s anonymous JSON requests from datacenter IPs)
NEYNAR_API_KEY=                # enables the Farcaster source (Neynar cast search)
X_BEARER_TOKEN=                # enables the X source (/2/tweets/counts/recent, polled every 15 min/market)
COINGECKO_API_KEY=             # optional CoinGecko demo key for the trending endpoint

# Pool event indexing (GET /pool/notes, /pool/positions)
POOL_ADDRESS=
POOL_DEPLOY_BLOCK=             # block the pool was deployed at; if unset only the last ~30k blocks are scanned
POOL_ABI_PATH=                 # optional ABI JSON override (bare array or Foundry artifact with "abi")
LOG_CHUNK_SIZE=5000            # getLogs block range per request (auto-halves on RPC errors)
POOL_SYNC_INTERVAL_SEC=15

# Relayer (POST /relay/transact|open|close). Needs RELAYER_PRIVATE_KEY + POOL_ADDRESS + vkeys.
RELAYER_PRIVATE_KEY=           # hot wallet holding BNB for gas only
VKEY_DIR=                      # dir with transact_vkey.json, open_vkey.json, close_vkey.json
                               # (also searched: server/vkeys/, ../circuits/build/)
MIN_RELAYER_FEE=0              # if > 0, transact must pay at least this fee (USDT wei) to the relayer address
RELAY_RATE_LIMIT_PER_MIN=10    # per IP, per relay endpoint

# Oracle reporter (pushes every EPOCH_LENGTH/2 seconds)
REPORTER_PRIVATE_KEY=          # must be an authorized reporter on AttentionOracle
ORACLE_ADDRESS=
